{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.3.2",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/alpheios_16.png",
    "32": "icons/alpheios_32.png",
    "128": "icons/alpheios_128.png"
  },
  "author": "The Alpheios Project, Ltd.",
  "homepage_url": "http://alpheios.net",
  "short_name": "Alpheios",
  "action": {
    "default_icon": "icons/alpheios_black_32.png",
    "default_title": "Activate Alpheios",
    "browser_style": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "contextMenus",
    "storage",
    "webNavigation",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "style/style-components.css",
        "styles/style.css",
        "compatibility-fixes.js",
        "support/webextension-polyfill/browser-polyfill.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
